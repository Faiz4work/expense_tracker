    {
      "name": "4 - Expenses and retry/pagination checks",
      "item": [
        {
          "name": "Create expense with a fresh retry key",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"et_key\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set(\"et_expense_id\", String(data.id));",
                  "pm.collectionVariables.set(\"et_etag\", pm.response.headers.get(\"ETag\"));",
                  "pm.collectionVariables.set(\"et_creation_body\", pm.response.text());",
                  "pm.test(\"Initial version and exact money\", function () { pm.expect(data.version).to.equal(1); pm.expect(data.amount).to.equal(\"1200.50\"); pm.expect(pm.response.headers.get(\"ETag\")).to.equal('\"1\"'); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{et_key}}"
              }
            ],
            "url": {
              "raw": "{{et_base_url}}/api/v1/expenses",
              "host": [
                "{{et_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "expenses"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": {{et_category_id}},\n  \"amount\": \"1200.50\",\n  \"currency\": \"PKR\",\n  \"description\": \"Groceries\",\n  \"spent_on\": \"{{et_spent_on}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Replay same key and body - same expense",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "pm.test(\"Exact original response replayed\", function () { pm.expect(pm.response.text()).to.equal(pm.collectionVariables.get(\"et_creation_body\")); pm.expect(pm.response.headers.get(\"ETag\")).to.equal('\"1\"'); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{et_key}}"
              }
            ],
            "url": {
              "raw": "{{et_base_url}}/api/v1/expenses",
              "host": [
                "{{et_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "expenses"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": {{et_category_id}},\n  \"amount\": \"1200.50\",\n  \"currency\": \"PKR\",\n  \"description\": \"Groceries\",\n  \"spent_on\": \"{{et_spent_on}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Changed body with same key - 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 422\", function () { pm.response.to.have.status(422); });",
                  "if (pm.response.code === 422) {",
                  "pm.test(\"Changed-body error code\", function () { pm.expect(pm.response.json().error.code).to.equal(\"idempotency_key_reused\"); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{et_key}}"
              }
            ],
            "url": {
              "raw": "{{et_base_url}}/api/v1/expenses",
              "host": [
                "{{et_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "expenses"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": {{et_category_id}},\n  \"amount\": \"1300.00\",\n  \"currency\": \"PKR\",\n  \"description\": \"Groceries\",\n  \"spent_on\": \"{{et_spent_on}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },

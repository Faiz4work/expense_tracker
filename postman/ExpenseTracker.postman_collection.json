          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{et_second_key}}"
              }
            ],
            "url": {
              "raw": "{{et_base_url}}/api/v1/expenses",
              "host": [
                "{{et_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "expenses"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": {{et_category_id}},\n  \"amount\": \"1300.00\",\n  \"currency\": \"PKR\",\n  \"description\": \"Groceries second item\",\n  \"spent_on\": \"{{et_spent_on}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Filter and get first page",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "var page = pm.response.json();",
                  "pm.test(\"One row and next cursor\", function () { pm.expect(page.items.length).to.equal(1); pm.expect(page.next_cursor).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"et_next_cursor\", page.next_cursor || \"\");",
                  "pm.collectionVariables.set(\"et_first_page_ids\", JSON.stringify(page.items.map(function (item) { return item.id; })));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{et_base_url}}/api/v1/expenses?category_id={{et_category_id}}&date_from={{et_date_from}}&date_to={{et_date_to}}&min_amount=1000.00&max_amount=2000.00&currency=PKR&q=groceries&limit=1",
              "host": [
                "{{et_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "expenses"
              ],
              "query": [
                {
                  "key": "category_id",
                  "value": "{{et_category_id}}"
                },
                {
                  "key": "date_from",
                  "value": "{{et_date_from}}"
                },
                {
                  "key": "date_to",
                  "value": "{{et_date_to}}"
                },
                {
                  "key": "min_amount",
                  "value": "1000.00"
                },
                {
                  "key": "max_amount",
                  "value": "2000.00"
                },
                {
                  "key": "currency",
                  "value": "PKR"
                },
                {
                  "key": "q",
                  "value": "groceries"
                },
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Get next page with the same filters",
          "event": [
            {
              "listen": "test",
              "script": {

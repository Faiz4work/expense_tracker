{
  "info": {
    "name": "Expense Tracker - implemented API workflow",
    "description": "Run the complete collection once in order with No environment selected. Default target is the local API. Register creates fresh synthetic credentials; later requests manage tokens, IDs, ETags, and cursors automatically. This workflow creates demo data in the application database. Unimplemented report, worker, CSV, and S3 routes are intentionally absent. Collection prepared for local verification; no live requests were run while generating it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{et_access_token}}",
        "type": "string"
      }
    ]
  },

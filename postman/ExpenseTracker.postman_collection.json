    {
      "name": "2 - Authentication",
      "item": [
        {
          "name": "Register a fresh demo account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var suffix = pm.variables.replaceIn(\"{{$guid}}\");",
                  "pm.collectionVariables.set(\"et_email\", \"postman+\" + suffix + \"@example.com\");",
                  "pm.collectionVariables.set(\"et_password\", \"Demo-\" + suffix + \"!Aa1\");",
                  "[\"et_access_token\", \"et_refresh_token\", \"et_user_id\", \"et_category_id\", \"et_expense_id\", \"et_second_expense_id\", \"et_etag\", \"et_stale_etag\", \"et_next_cursor\", \"et_creation_body\", \"et_first_page_ids\", \"et_key\", \"et_second_key\"].forEach(function (name) {",
                  "    pm.collectionVariables.set(name, \"\");",
                  "});",
                  "var today = new Date();",
                  "pm.collectionVariables.set(\"et_spent_on\", today.toISOString().slice(0, 10));",
                  "pm.collectionVariables.set(\"et_date_from\", new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), 1)).toISOString().slice(0, 10));",
                  "pm.collectionVariables.set(\"et_date_to\", new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth() + 1, 0)).toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "pm.collectionVariables.set(\"et_user_id\", String(pm.response.json().id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{et_base_url}}/api/v1/auth/register",
              "host": [
                "{{et_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{et_email}}\",\n  \"password\": \"{{et_password}}\",\n  \"base_currency\": \"PKR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login and save tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "var data = pm.response.json();",
                  "pm.test(\"Access and refresh tokens returned\", function () {",
                  "    pm.expect(data.access_token).to.be.a(\"string\");",
                  "    pm.expect(data.refresh_token).to.be.a(\"string\");",
                  "    pm.expect(data.expires_in).to.equal(900);",
                  "});",
                  "pm.collectionVariables.set(\"et_access_token\", data.access_token);",
                  "pm.collectionVariables.set(\"et_refresh_token\", data.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{et_base_url}}/api/v1/auth/login",
              "host": [
                "{{et_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{et_email}}\",\n  \"password\": \"{{et_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Current user with access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "pm.test(\"Correct user\", function () { pm.expect(String(pm.response.json().id)).to.equal(pm.collectionVariables.get(\"et_user_id\")); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{et_base_url}}/api/v1/auth/me",
              "host": [
                "{{et_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Rotate refresh token and save new pair",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "pm.test(\"Refresh token rotated\", function () { pm.expect(pm.response.json().refresh_token).not.to.equal(pm.collectionVariables.get(\"et_refresh_token\")); });",
                  "var data = pm.response.json();",
                  "pm.test(\"Access and refresh tokens returned\", function () {",
                  "    pm.expect(data.access_token).to.be.a(\"string\");",
                  "    pm.expect(data.refresh_token).to.be.a(\"string\");",
                  "    pm.expect(data.expires_in).to.equal(900);",
                  "});",
                  "pm.collectionVariables.set(\"et_access_token\", data.access_token);",
                  "pm.collectionVariables.set(\"et_refresh_token\", data.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{et_base_url}}/api/v1/auth/refresh",
              "host": [
                "{{et_base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{et_refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
